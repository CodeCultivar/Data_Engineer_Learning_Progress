rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // One document per signed-in user: users/{uid}/progress/state.
    // Everyone can reach only their own document, never anyone else's.
    match /users/{uid}/progress/{doc} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;

      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['data', 'updatedAt'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 200000;
        // PERSONAL-USE MODE (only you may use this project): add this line before the semicolon above
        // so strangers cannot sign in and use your free quota:
        //   && request.auth.token.email == 'YOUR_EMAIL@gmail.com'
    }
    // everything else stays denied by default
  }
}
